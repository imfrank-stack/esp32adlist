[Unit]
Description=esp32adlist - ESP32 广告过滤规则 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=adlist
Group=adlist
WorkingDirectory=/opt/esp32adlist
ExecStart=/opt/esp32adlist/server -addr :8080 -dir /opt/esp32adlist/data/dist
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/esp32adlist

[Install]
WantedBy=multi-user.target
